rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function existingData() {
      return resource.data;
    }
    function incomingData() {
      return request.resource.data;
    }
    function isAdmin() {
      // For now, allow specific email. In production, use an admins collection.
      return isSignedIn() && (request.auth.token.email == 'lakshkothari35@gmail.com');
    }

    // Menu permissions
    match /menu/{itemId} {
      allow read: if true; // Public can read menu
      allow write: if isAdmin();
    }

    // Reviews permissions
    match /reviews/{reviewId} {
      allow read: if true; // Public can see reviews
      allow create: if true; // Public can submit reviews (maybe add recaptcha or rate limiting later)
      allow update, delete: if isAdmin();
    }

    // Orders permissions
    match /orders/{orderId} {
      allow create: if true; // Public can place orders
      allow read, update, delete: if isAdmin();
    }

    // Gallery permissions
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
